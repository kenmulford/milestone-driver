# Normalize line endings in the repository to LF.
* text=auto

# The polyglot hook launcher is parsed by BOTH cmd and bash. CRLF breaks the
# bash heredoc close (`CMDBLOCK\r` never matches the `CMDBLOCK` delimiter), so
# it MUST stay LF in the working tree even on Windows (core.autocrlf=true).
*.cmd text eol=lf

# Shell scripts MUST be LF even in the working tree — CRLF breaks the
# shebang and produces "bad interpreter" / "\r command not found" on
# Linux, macOS, WSL, and git-bash.
*.sh text eol=lf

# PowerShell scripts: keep LF too for clean cross-platform diffs.
# pwsh 7+ runs LF scripts fine on Windows, Linux, and macOS.
*.ps1 text eol=lf

# The golden test matrix is TAB-delimited and parsed byte-for-byte by both
# runners; keep it LF so the parity contract stays stable cross-platform.
*.tsv text eol=lf

# CI-preflight fixtures + goldens are compared byte-for-byte by both runners.
# Pin them to LF so a Windows checkout (core.autocrlf=true) can't turn the
# .yml/.txt/.md fixtures into CRLF and break the golden comparison.
tests/fixtures/** text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown carries the GOVERNED files (skills/**, agents/**) that
# scripts/check-size-budgets.sh measures in BYTES ON DISK. A CRLF working tree
# adds one byte per line, and for two of them that alone is more than their
# whole remaining headroom: agents/triage-reviewer.md has 0.12% headroom against
# a 0.70% CRLF cost, agents/design-reviewer.md 0.43% against 0.67%. Without this
# pin a Windows contributor's FIRST CLONE reports
# `FAIL agents/design-reviewer.md 110/115 16540/16500` on files they never
# touched. Pinning LF is what makes the byte ceilings mean the same number on
# every platform; headroom cannot be sized to absorb it.
*.md text eol=lf
